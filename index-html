<script>
/* ============ TRADUCTIONS ============ */
const T = {
  fr: {
    appTitle:"Signalement Chantier",
    hello:"Que souhaitez-vous faire ?",
    home:"Accueil", report:"Signaler", reports:"Mes rapports", emergency:"Urgence", myReports:"Mes signalements",
    reportEvent:"Signaler un événement", emergencyNumbers:"Numéros d'urgence",
    emergencyHint:"Appuyez sur « Appeler » pour joindre directement le service.",
    type:"Type d'événement *", nearMiss:"Presque-accident", incident:"Incident", accident:"Accident", envImpact:"Impact environnemental",
    severity:"Gravité *", minor:"Mineure", moderate:"Modérée", severe:"Grave", critical:"Critique",
    zone:"Zone / lieu *", zonePlaceholder:"Zone ou scannez le QR code",
    description:"Description *", descPlaceholder:"Décrivez ce qui s'est passé...",
    voice:"Dicter", photo:"Photo (optionnel)", addPhoto:"Ajouter une photo",
    anonymous:"Signaler anonymement (recommandé si vous préférez)",
    name:"Votre nom (optionnel)", send:"Envoyer le signalement", back:"Retour",
    success:"Signalement envoyé", successMsg:"Votre signalement a été enregistré et transmis au responsable HSE.",
    backHome:"Retour à l'accueil", call:"Appeler",
    civilProtection:"Protection Civile", civilProtection2:"Protection Civile (SAMU)",
    police:"Police", gendarmerie:"Gendarmerie Nationale", forests:"Conservation des forêts", sst:"Responsable SST dédié",
    homeHint:"Scannez le QR code de votre zone pour signaler rapidement un événement.",
    required:"Veuillez remplir les champs obligatoires.",
    noReports:"Aucun signalement pour le moment.",
    scanDone:"Zone scannée : ", cancel:"Annuler",
    criticalAlert:"⚠️ Signalement critique — le responsable SST a été notifié."
  },
  ar: {
    appTitle:"الإبلاغ في الورشة",
    hello:"ماذا تريد أن تفعل؟",
    home:"الرئيسية", report:"الإبلاغ", reports:"بلاغاتي", emergency:"طوارئ", myReports:"بلاغاتي",
    reportEvent:"الإبلاغ عن حدث", emergencyNumbers:"أرقام الطوارئ",
    emergencyHint:"اضغط على « اتصل » للتواصل المباشر مع المصالح.",
    type:"نوع الحدث *", nearMiss:"شبه حادث", incident:"حادث بسيط", accident:"حادث", envImpact:"تأثير بيئي",
    severity:"الخطورة *", minor:"طفيف", moderate:"متوسط", severe:"خطير", critical:"حرج",
    zone:"المنطقة / المكان *", zonePlaceholder:"المنطقة أو امسح رمز QR",
    description:"الوصف *", descPlaceholder:"صف ما حدث...",
    voice:"إملاء صوتي", photo:"صورة (اختياري)", addPhoto:"إضافة صورة",
    anonymous:"الإبلاغ بشكل مجهول (إن رغبت)",
    name:"اسمك (اختياري)", send:"إرسال البلاغ", back:"رجوع",
    success:"تم إرسال البلاغ", successMsg:"تم تسجيل بلاغك وإرساله إلى مسؤول السلامة والصحة.",
    backHome:"العودة إلى الرئيسية", call:"اتصل",
    civilProtection:"الحماية المدنية", civilProtection2:"الحماية المدنية (الإسعاف)",
    police:"الشرطة", gendarmerie:"الدرك الوطني", forests:"محافظة الغابات", sst:"مسؤول السلامة والصحة",
    homeHint:"امسح رمز QR الخاص بمنطقتك للإبلاغ السريع.",
    required:"يرجى ملء الحقول الإلزامية.",
    noReports:"لا يوجد بلاغ حاليا.",
    scanDone:"تم مسح المنطقة: ", cancel:"إلغاء",
    criticalAlert:"⚠️ بلاغ حرج — تم إشعار مسؤول السلامة والصحة."
  }
};

let lang = localStorage.getItem("cosider_lang") || "fr";

/* ============ i18n ============ */
function applyLang(){
  const dict = T[lang];
  document.documentElement.lang = lang;
  document.documentElement.dir = lang === "ar" ? "rtl" : "ltr";
  document.getElementById("langToggle").textContent = lang === "fr" ? "العربية" : "Français";
  document.querySelectorAll("[data-i18n]").forEach(el=>{
    const k = el.getAttribute("data-i18n");
    if(dict[k]) el.textContent = dict[k];
  });
  document.querySelectorAll("[data-i18n-ph]").forEach(el=>{
    const k = el.getAttribute("data-i18n-ph");
    if(dict[k]) el.placeholder = dict[k];
  });
  localStorage.setItem("cosider_lang", lang);
  renderReports();
}
document.getElementById("langToggle").onclick = ()=>{ lang = lang==="fr"?"ar":"fr"; applyLang(); };

/* ============ NAVIGATION ============ */
function go(screen){
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
  document.getElementById("screen-"+screen).classList.add("active");
  document.querySelectorAll(".bottom-nav button").forEach(b=>{
    b.classList.toggle("active", b.dataset.nav === screen);
  });
  if(screen === "reports") renderReports();
  window.scrollTo(0,0);
}

/* ============ CHIPS ============ */
let formData = { type:null, severity:null };
document.querySelectorAll("#typeChips .chip").forEach(c=>{
  c.onclick = ()=>{
    document.querySelectorAll("#typeChips .chip").forEach(x=>x.classList.remove("active"));
    c.classList.add("active"); formData.type = c.dataset.val;
  };
});
document.querySelectorAll("#sevChips .chip").forEach(c=>{
  c.onclick = ()=>{
    document.querySelectorAll("#sevChips .chip").forEach(x=>x.classList.remove("active"));
    c.classList.add("active"); formData.severity = c.dataset.val;
  };
});

/* ============ ANONYME ============ */
document.getElementById("anonCheck").onchange = (e)=>{
  document.getElementById("nameBlock").style.display = e.target.checked ? "none" : "block";
};

/* ============ PHOTO ============ */
function previewPhoto(e){
  const f = e.target.files[0]; if(!f) return;
  const r = new FileReader();
  r.onload = ev=>{
    document.getElementById("photoImg").src = ev.target.result;
    document.getElementById("photoPreview").style.display = "block";
  };
  r.readAsDataURL(f);
}

/* ============ VOIX ============ */
function startVoice(){
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){ toast("Reconnaissance vocale non disponible"); return; }
  const r = new SR();
  r.lang = lang === "ar" ? "ar-DZ" : "fr-FR";
  r.interimResults = false;
  r.onresult = e=>{
    const t = e.results[0][0].transcript;
    const ta = document.getElementById("descInput");
    ta.value += (ta.value ? " " : "") + t;
  };
  r.start();
  toast("🎤 " + (lang==="fr"?"Écoute en cours...":"جاري الاستماع..."));
}

/* ============ QR ============ */
let qrScanner = null;
function openQr(){
  document.getElementById("qr-modal").classList.add("active");
  qrScanner = new Html5Qrcode("qr-reader");
  qrScanner.start(
    { facingMode:"environment" },
    { fps:10, qrbox:{width:250, height:250} },
    (decoded)=>{ document.getElementById("zoneInput").value = decoded; closeQr(); toast(T[lang].scanDone + decoded); },
    ()=>{}
  ).catch(err=>{ toast("Caméra indisponible"); closeQr(); });
}
function closeQr(){
  document.getElementById("qr-modal").classList.remove("active");
  if(qrScanner){ qrScanner.stop().then(()=>{ qrScanner.clear(); qrScanner=null; }).catch(()=>{}); }
}

/* ============ SOUMISSION ============ */
function submitReport(){
  const zone = document.getElementById("zoneInput").value.trim();
  const desc = document.getElementById("descInput").value.trim();
  if(!formData.type || !formData.severity || !zone || !desc){
    toast(T[lang].required); return;
  }
  const isAnon = document.getElementById("anonCheck").checked;
  const name = isAnon ? null : document.getElementById("nameInput").value.trim() || null;

  const report = {
    id: "R-" + Date.now(),
    type: formData.type,
    severity: Number(formData.severity),
    zone, desc, name, anonymous: isAnon,
    photo: document.getElementById("photoImg").src || null,
    date: new Date().toISOString()
  };
  const all = JSON.parse(localStorage.getItem("cosider_reports") || "[]");
  all.unshift(report);
  localStorage.setItem("cosider_reports", JSON.stringify(all));

  if(report.severity >= 3) setTimeout(()=>toast(T[lang].criticalAlert), 400);

  // reset
  formData = { type:null, severity:null };
  document.querySelectorAll(".chip").forEach(x=>x.classList.remove("active"));
  document.getElementById("zoneInput").value = "";
  document.getElementById("descInput").value = "";
  document.getElementById("nameInput").value = "";
  document.getElementById("anonCheck").checked = false;
  document.getElementById("nameBlock").style.display = "none";
  document.getElementById("photoPreview").style.display = "none";
  document.getElementById("photoImg").src = "";
  document.getElementById("photoInput").value = "";

  go("success");
}

/* ============ LISTE ============ */
function renderReports(){
  const box = document.getElementById("reportsList");
  const all = JSON.parse(localStorage.getItem("cosider_reports") || "[]");
  if(!all.length){ box.innerHTML = `<div class="card" style="text-align:center;color:var(--muted)">${T[lang].noReports}</div>`; return; }
  box.innerHTML = all.map(r=>{
    const typeLabel = T[lang][r.type] || r.type;
    const sevLabel = T[lang][{1:"minor",2:"moderate",3:"severe",4:"critical"}[r.severity]] || "";
    const d = new Date(r.date).toLocaleString(lang==="ar"?"ar-DZ":"fr-FR");
    return `<div class="report-item">
      <div class="rt">${typeLabel} <span class="badge g${r.severity}">${sevLabel}</span> ${r.anonymous?'<span class="badge anon">Anonyme</span>':''}</div>
      <div class="meta"><span>📍 ${r.zone}</span><span>🕒 ${d}</span></div>
      <div style="font-size:14px;margin-top:6px;color:#374151">${r.desc}</div>
    </div>`;
  }).join("");
}

/* ============ TOAST ============ */
let toastT;
function toast(msg){
  const t = document.getElementById("toast");
  t.textContent = msg; t.classList.add("show");
  clearTimeout(toastT); toastT = setTimeout(()=>t.classList.remove("show"), 3000);
}

/* ============ INIT ============ */
applyLang();
</script>
</body>
</html>
